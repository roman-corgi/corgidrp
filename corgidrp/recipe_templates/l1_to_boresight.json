                "KGain" : "AUTOMATIC",
                "DetectorParams" : "AUTOMATIC"
            }
        },
        {
            "name" : "dark_subtraction",
            "calibs" : {
                "DetectorNoiseMaps" : "AUTOMATIC"
            },
            "keywords" : {
                "outputdir" : "AUTOMATIC"
            }
        },
        {
            "name" : "desmear",
            "calibs" : {
                "DetectorParams" : "AUTOMATIC"
            }
        },
        {
            "name" : "cti_correction",
            "calibs" : {
                "TrapCalibration" : "AUTOMATIC,OPTIONAL"
            }
        },
        {
            "name" : "flat_division",
