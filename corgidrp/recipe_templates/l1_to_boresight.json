                "FlatField" : "AUTOMATIC"
            }
        },
        {
            "name" : "correct_bad_pixels",
            "calibs" : {
                "BadPixelMap" : "AUTOMATIC"
            }
        },
        {
            "name" : "update_to_l2b"
        },
        {
            "name" : "save"
        }, 
        {
            "name" : "boresight_calibration",
            "keywords" : {
                "frames_to_combine" : true,
                "find_threshold" : 30,
                "fit_pair_offsets" : false,
                "match_method" : "auto",
                "max_pointing_offset" : 10.0,
                "northangle_tol" : 2.0,
                "min_match_fraction" : 0.25,
                "min_matches" : 4,
                "match_radius" : 2.0,
                "platescale_guess" : 21.8,
                "platescale_tol" : 0.1,
                "comparison_threshold" : 50,
                "search_rad" : 0.005
            }
        },
        {
            "name" : "save"
        }
    ]
