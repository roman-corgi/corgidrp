{
    "name" : "noisemap_generation_1",
    "template" : true,
    "process_in_chunks" : true,
    "drpconfig" : {
        "track_individual_errors" : false
    },
    "inputs" : [],
    "outputdir" : "",
    "steps" : [
        {
            "name" : "prescan_biassub",
            "keywords" : {
                "return_full_frame" : true,
                "dataset_copy" : false
            }
        },
        {
            "name" : "discard_setup_frames",
            "keywords" : {
                "keywords_to_check" : ["ISACQ"]
            }
        },
        {
            "name" : "detect_cosmic_rays",
            "calibs" : {
                "DetectorParams" : "AUTOMATIC",
                "KGain" : "AUTOMATIC, OPTIONAL"
            },
            "keywords" : {
                "mode" : "full",
                "dataset_copy" : false,
                "median_filter_mode" : 2,
                "cosm_thresh" : 0.066,
                "plat_thresh" : 0.066,
                "cosm_filter" : 3,
                "cosm_box" : 4,
                "cosm_tail" : 0
            }
        },
        {
            "name" : "correct_nonlinearity",
            "calibs" : {
                "NonLinearityCalibration" : "AUTOMATIC"
            }
        },
        {
            "name" : "update_to_l2a"
        },
        {
            "name" : "convert_to_electrons",
            "calibs" : {
                "KGain" : "AUTOMATIC"
            }
        },
        {
            "name": "update_to_intermediate",
            "keywords": {
                "intermediate_level": 1
            }
        },
        {
            "name" : "save"
        }
    ]
}